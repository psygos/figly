<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <application>
        <!-- LOOM — the Glyph Matrix toy. AOD only on the (4a) Pro:
             Settings → Glyph Interface → Flip to Glyph → Always-on Glyph Toy. -->
        <service
            android:name="app.figly.glyph.LoomToyService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/loom_toy_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/img_loom_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/loom_toy_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>
    </application>
</manifest>
